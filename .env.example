# --- املاک کیایی ---
TARGET_URL=https://amlakkiaei.ir/customers
LOGIN_URL=https://amlakkiaei.ir/login?next=%2Fcustomers
AMLAK_MOBILE=
AMLAK_OTP=
AUTH_STATE_PATH=output/auth_state.json

# --- Playwright ---
HEADLESS=true
PROXY_URL=
MAX_PAGES=10
SCROLL_ROUNDS=15
SCROLL_PAUSE_MS=800
NAVIGATION_TIMEOUT_MS=60000

# --- LLM: groq یا openai ---
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

BATCH_SIZE=25
MAX_ITEMS_TO_ANALYZE=120

OUTPUT_DIR=output
